<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />

    <!-- Azurite, Microsoft's own Azure Blob emulator. The resume store is the
         one piece of this system whose correctness is mostly in what a signed
         URL says, and a hand-written double cannot get that wrong on our
         behalf. -->
    <PackageReference Include="Testcontainers.Azurite" Version="4.14.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MorganHacks.Api\MorganHacks.Api.csproj" />
    <ProjectReference Include="..\MorganHacks.Applications\MorganHacks.Applications.csproj" />
    <ProjectReference Include="..\MorganHacks.Migrations\MorganHacks.Migrations.csproj" />
  </ItemGroup>

</Project>