{
  "Cors": {
    "Origins": [ "http://localhost:3000", "http://localhost:3001", "http://localhost:3002" ]
  },
  "ReverseProxy": {
    // The route allowlist in appsettings.json has no catch-all, deliberately,
    // so a new path is unreachable until somebody adds it here. This adds the
    // development sign-in door.
    //
    // It is in this file and not the other one because this file is loaded
    // only when the environment is Development. Every deployed container sets
    // Staging or Production, so the route does not exist there, which matches
    // atlas: the endpoint itself is registered only under Development too.
    // Two independent reasons it cannot be reached in a deployed environment,
    // and neither depends on the other.
    //
    // Keep every comment in this file ASCII. A single non-ASCII character here
    // stops the whole configuration binding, and the symptom is every route
    // answering 404 with nothing logged.
    "Routes": {
      "dev-sign-in": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/dev/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      }
    },
    "Clusters": {
      "atlas": {
        "Destinations": {
          "primary": { "Address": "http://localhost:5080/" }
        }
      }
    }
  }
}
