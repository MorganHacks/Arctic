{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  "Cors": {
    "Origins": ["https://morganhacks.com", "https://www.morganhacks.com"]
  },

  "ReverseProxy": {
    "Routes": {
      "auth": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "RateLimiterPolicy": "auth-strict",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "applications": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/applications/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "profiles": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/profiles/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "admin": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/admin/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      },
      "checkin": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/checkin/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [ { "PathRemovePrefix": "/api" } ]
      }
    },

    "Clusters": {
      "atlas": {
        "Destinations": {
          "primary": { "Address": "http://atlas:8080/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" }
      }
    }
  }
}
