{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",

  "Cors": {
    "Origins": ["https://morganhacks.com", "https://www.morganhacks.com"]
  },

  "ReverseProxy": {
    "Routes": {
      "webhooks": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/webhooks/{**catch-all}" },
        "RateLimiterPolicy": "webhook",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      // "auth-me" sits ahead of "auth" because /auth/me is not the same kind
      // of endpoint as the rest of /auth. It costs a session lookup and
      // nothing else, and the console asks it on every page it renders — so
      // under the strict limiter the eleventh page in a quarter of an hour
      // logged somebody out. Per IP, which on campus is the whole building
      // sharing ten page views. Atlas already refuses to throttle it for the
      // same reason; this route is what stops the gateway overruling that.
      "auth-me": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/auth/me" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "auth": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/auth/{**catch-all}" },
        "RateLimiterPolicy": "auth-strict",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      // The public forms site. No session, no permission — the code in the URL
      // is the whole permission, so this route is reachable by anyone holding
      // a link and by nothing else.
      //
      // The standard policy, not the strict one: this covers reading a form as
      // well as submitting it, and reading is what happens when a lecture hall
      // opens the same link at once. Atlas throttles the submit half on its
      // own, which is the half where a limit means something.
      // The public forms site. No session and no permission: the code in the
      // URL is the whole permission, so this is reachable by anyone holding a
      // link and by nothing else.
      //
      // The standard policy rather than the strict one, because this covers
      // reading a form as well as submitting it, and reading is what a lecture
      // hall does when the link goes up on a slide. Atlas throttles the submit
      // half itself, which is the half where a limit means anything.
      "forms": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/forms/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "applications": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/applications/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "profiles": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/profiles/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "admin": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/admin/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      },
      "checkin": {
        "ClusterId": "atlas",
        "Match": { "Path": "/api/checkin/{**catch-all}" },
        "RateLimiterPolicy": "standard",
        "Transforms": [
          { "PathRemovePrefix": "/api" },
          { "X-Forwarded": "Set" }
        ]
      }
    },

    "Clusters": {
      "atlas": {
        "Destinations": {
          "primary": { "Address": "http://atlas:8080/" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health"
          }
        },
        "Metadata": { "ConsecutiveFailuresHealthPolicy.Threshold": "3" }
      }
    }
  }
}
