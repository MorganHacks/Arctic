<Project>
  <!--
    Shared settings for every library under libs/.
    
    The same rules the services are held to. This code runs inside all three of
    them, so holding it to a lower standard than the code that calls it would
    be exactly backwards — a warning suppressed here is one suppressed
    everywhere at once.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
</Project>
